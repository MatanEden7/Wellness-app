<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules for API 30 and below (android:fullBackupContent).

  The data snapshot is written by path_provider's getApplicationDocumentsDirectory(),
  which on Android resolves to context.getDir("flutter", MODE_PRIVATE) --
  i.e. <app data>/app_flutter/. That lives directly under the app data dir, so it
  belongs to the "root" domain, NOT "file" (which is getFilesDir()).

  Nothing here needs to name no_backup/: the OS always excludes it, which is how
  the in-app "Back up to iCloud/Google" toggle opts out on Android.
-->
<full-backup-content>
    <include domain="root" path="app_flutter/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
