<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) replacement for backup_rules.xml
  (android:dataExtractionRules). Same domains -- see that file for why "root".

  cloud-backup  = Google Drive backup
  device-transfer = direct device-to-device migration
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
