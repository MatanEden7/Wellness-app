          }
        }
      }
    },
    "deleteAllTemplatesWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every workout and meal template — the ones that shipped with the app, the ones generated from your profile, and any you built yourself.\n\nYour food catalog, exercise library and everything you have logged are kept. The shipped templates will not come back on their own; rebuilding your plan from your profile will generate new ones."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת כל תבנית אימון וארוחה — אלה שהגיעו עם האפליקציה, אלה שנוצרו מהפרופיל שלכם, וכל תבנית שבניתם בעצמכם.\n\nקטלוג המזון, ספריית התרגילים וכל מה שרשמתם נשמרים. התבניות המובנות לא יחזרו מעצמן; בנייה מחדש של התוכנית מהפרופיל תיצור תבניות חדשות."
          }
        }
      }
    },
