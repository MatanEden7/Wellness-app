    "profileRegenBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile changed in a way that affects which meals and workouts suit you.\n\nRebuilding replaces %1$lld generated meal template(s) and %2$lld generated workout template(s). Anything you created or edited yourself is kept."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופיל שלך השתנה באופן שמשפיע על הארוחות והאימונים שמתאימים לך.\n\nבנייה מחדש תחליף %1$lld תבניות ארוחה שנוצרו אוטומטית ו-%2$lld תבניות אימון שנוצרו אוטומטית. כל מה שיצרת או ערכת בעצמך נשמר."
          }
        }
      }
    },
